HIKVISION_HOST=changeme
HIKVISION_USERNAME=changeme
HIKVISION_PASSWORD=changeme
# Optional — only set if the DVR uses non-standard ports (defaults: 80/554)
# HIKVISION_HTTP_PORT=80
# HIKVISION_RTSP_PORT=554

# Optional — only set if one of these conflicts with something else already
# running on this host (defaults shown; these are this service's own local
# mediamtx sidecar ports, not DVR ports)
# MEDIAMTX_HLS_PORT=8888
# MEDIAMTX_WEBRTC_PORT=8889
# MEDIAMTX_API_PORT=9997
# MEDIAMTX_RTSP_PORT=8554

# Optional — this local service's own bind address/port (defaults shown).
# Not currently read by anything (uvicorn's --host/--port flags are what
# actually control this, see AGENTS.md) — kept for whenever a run script
# wires it up.
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8896
